# Aptos / Shelby configuration
NEXT_PUBLIC_APTOS_NETWORK=testnet
NEXT_PUBLIC_APTOS_API_KEY=aptoslabs_YOUR_KEY_HERE
NEXT_PUBLIC_SHELBY_API_KEY=shelby_YOUR_KEY_HERE

# Move package address (empty until published)
NEXT_PUBLIC_PUZZLE_REGISTRY_ADDRESS=

# Prefer server-only faucet URLs (allowlisted hosts only). NEXT_PUBLIC_* still works as fallback.
APTOS_FAUCET_URL=https://faucet.testnet.aptoslabs.com
SHELBYUSD_FAUCET_URL=https://faucet.shelby.xyz/shelbyusd
# Set to false to disable /api/faucet/* entirely
FAUCET_ENABLED=true

# Gate /curator — open /curator?key=<secret> (sets httpOnly cookie)
CURATOR_GATE_SECRET=

# Ed25519 key that signs reward claim tickets for rewards::claim_with_proof.
# Generate with `npm run claim:keygen`, then register the printed public key
# on-chain via rewards::set_verifier. Without it /api/claim-ticket returns 501
# and claims fall back to the legacy path (blocked once require_proof is on).
CLAIM_SIGNER_PRIVATE_KEY=

# Casual anti-tamper HMAC salt for level progress (not a substitute for on-chain proof)
NEXT_PUBLIC_PROGRESS_SALT=change-me-to-a-long-random-string
