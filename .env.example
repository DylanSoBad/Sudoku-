# Aptos / Shelby configuration
NEXT_PUBLIC_APTOS_NETWORK=testnet
NEXT_PUBLIC_APTOS_API_KEY=aptoslabs_YOUR_KEY_HERE
NEXT_PUBLIC_SHELBY_API_KEY=shelby_YOUR_KEY_HERE

# Move package address (empty until published)
NEXT_PUBLIC_PUZZLE_REGISTRY_ADDRESS=

# Faucet endpoints (defaults safe for testnet)
NEXT_PUBLIC_APTOS_FAUCET_URL=https://faucet.testnet.aptoslabs.com
NEXT_PUBLIC_SHELBYUSD_FAUCET_URL=https://faucet.shelby.xyz/shelbyusd

# Casual anti-tamper HMAC salt for level progress
NEXT_PUBLIC_PROGRESS_SALT=change-me-to-a-long-random-string
