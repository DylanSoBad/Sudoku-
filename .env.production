# Public deployment config, committed on purpose.
#
# Everything here is an on-chain address or a public endpoint that Next.js
# inlines into the client bundle anyway, so keeping it in git is what makes a
# `git push` deploy reproducible. Without NEXT_PUBLIC_PUZZLE_REGISTRY_ADDRESS
# the client silently falls back to offline hints and never signs a
# transaction, which is the bug this file exists to prevent.
#
# Credentials must NOT go here. Set these in the Vercel dashboard instead:
#   NEXT_PUBLIC_APTOS_API_KEY    (higher RPC rate limits)
#   NEXT_PUBLIC_SHELBY_API_KEY   (Shelby network downloads; optional — the
#                                 app also serves curator blobs from
#                                 /public/puzzles as a same-origin mirror)
#   NEXT_PUBLIC_PROGRESS_SALT    (optional; lib/progress.ts has a default)
#
# To add the Shelby key on Vercel:
#   Project → Settings → Environment Variables → Production
#   Name: NEXT_PUBLIC_SHELBY_API_KEY   Value: <your key>   → Redeploy
#
# Values set in the Vercel dashboard override this file, so per-environment
# overrides still work.

NEXT_PUBLIC_APTOS_NETWORK=testnet
NEXT_PUBLIC_LOCAL_MODE=false

# Move package published 2026-08-04
# tx 0x2b235ac62b090352c1ce1fc04df8ca3fed7212671ac76b2e80e39e2313a56d9e
NEXT_PUBLIC_PUZZLE_REGISTRY_ADDRESS=0x071a8a3d2ca013623dba02737a3824d898756eddad5f991aa55d2155c45fa20a

# The deployer is also the curator that uploads puzzle blobs to Shelby.
NEXT_PUBLIC_CURATOR_ADDRESS=0x071a8a3d2ca013623dba02737a3824d898756eddad5f991aa55d2155c45fa20a

# shelbyUSD fungible asset. decimals=8 confirmed against the FA metadata object.
NEXT_PUBLIC_SHELBY_USD_MODULE=0x249f5c642a63885ff88a5113b3ba0079840af5a1357706f8c7f3bfc5dd12511f
NEXT_PUBLIC_TOKEN_MODULE_ADDRESS=0x249f5c642a63885ff88a5113b3ba0079840af5a1357706f8c7f3bfc5dd12511f
NEXT_PUBLIC_SHELBYUSD_FA_METADATA=0x1b18363a9f1fe5e6ebf247daba5cc1c18052bb232efdc4c50f556053922d98e1
NEXT_PUBLIC_SHELBY_USD_DECIMALS=8

NEXT_PUBLIC_APTOS_FAUCET_URL=https://faucet.testnet.aptoslabs.com
NEXT_PUBLIC_SHELBYUSD_FAUCET_URL=https://faucet.shelby.xyz/shelbyusd
